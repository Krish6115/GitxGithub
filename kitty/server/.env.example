# Copy to kitty/server/.env (gitignored). Never commit real keys.

# Which LLM backend the server uses: "mock" (deterministic canned answers, no key needed) or "bharatcode".
LLM_PROVIDER=mock

# Port for the local Kitty server.
PORT=8787

# BharatCode (OpenAI-compatible). Only needed when LLM_PROVIDER=bharatcode.
# Users can also bring their own key per request via the X-Kitty-Key header.
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_API_KEY=

# Optional GitHub token (fine-grained, read-only, public repos). Raises REST API rate limits, enables code search for
# repo questions in the chat, and lets "Why did this fail?" read full GitHub Actions logs.
GITHUB_TOKEN=

# Requests per minute per IP when the server's own key is used.
RATE_LIMIT_PER_MIN=20

# Model streaming timeouts (ms): wait for the first chunk (free-tier queueing), then max silence between chunks.
# Each feature also has a hard total cap: tour 180s, tutor 90s, explain 45s (server/src/llm/budgets.ts).
LLM_FIRST_TOKEN_MS=60000
LLM_IDLE_MS=30000

# Repo tours are cached per owner/repo@commit for this many minutes.
TOUR_CACHE_TTL_MIN=360

# Upper limit on tour steps (4-15). Kitty picks 5-12 by repo size (small repos get shorter tours).
TOUR_MAX_STEPS=12
