# Copy to kitty/.env (gitignored). Never commit real keys.

# Which LLM backend the server uses: "mock" (deterministic canned answers, no key needed) or "bharatcode".
LLM_PROVIDER=mock

# Port for the local Kitty server.
PORT=8787

# BharatCode (OpenAI-compatible). Only needed when LLM_PROVIDER=bharatcode.
# Users can also bring their own key per request via the X-Kitty-Key header.
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_API_KEY=

# Optional GitHub token (read-only, public repos) to raise REST API rate limits for repo tours.
GITHUB_TOKEN=

# Requests per minute per IP when the server's own key is used.
RATE_LIMIT_PER_MIN=20

# Overall deadline for one model request, retries included (milliseconds).
LLM_TIMEOUT_MS=60000

# Repo tours are cached per owner/repo@commit for this many minutes.
TOUR_CACHE_TTL_MIN=360

# Maximum steps in a repo tour (4-15).
TOUR_MAX_STEPS=10
