{
  "name": "kitty",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "ingest"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run typecheck && npm run build -w server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "ingest": "npm run ingest -w ingest"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
